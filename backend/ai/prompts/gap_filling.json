{
  "name": "gap_filling",
  "version": "v1",
  "template": "Fill each gap using ONLY the cited reference chunk. Mark blocks\nwith block_type=\"gap_fill\" and cite the reference chunk id.\n\nEVIDENCE_JSON:{evidence_json}\nGAPS:{gaps_json}",
  "output_schema": {
    "type": "object",
    "required": ["blocks"],
    "properties": {
      "blocks": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["block_type", "content", "generation_method", "source_chunk_ids"],
          "properties": {
            "block_type": {"type": "string"},
            "title": {"type": "string"},
            "content": {"type": "string"},
            "generation_method": {"enum": ["llm", "rule_based", "user_edited", "transcribed"]},
            "source_chunk_ids": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  },
  "output_schema_version": "v1",
  "description": "Fill detected gaps using reference material",
  "tags": ["enrichment", "gap_filling"]
}