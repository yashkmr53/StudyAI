# StudyAI environment template — copy to .env and fill in.
# NEVER commit real values. Placeholders only.
# Generate secrets yourself; never let tooling write them into this file.

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_urlsafe(64))">
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_HSTS_SECONDS=0

# The four =0 flags above suit plain-HTTP localhost development only.
# For any exposed deployment use the safe defaults:
# DJANGO_SECURE_SSL_REDIRECT=1, DJANGO_SESSION_COOKIE_SECURE=1,
# DJANGO_CSRF_COOKIE_SECURE=1, DJANGO_HSTS_SECONDS=31536000

# --- PostgreSQL (required) ---
POSTGRES_DB=studyai
POSTGRES_USER=studyai
POSTGRES_PASSWORD=<generate: python -c "import secrets; print(secrets.token_urlsafe(32))">
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# --- Redis / Celery ---
CELERY_BROKER_URL=redis://redis:6379/0

# --- Scheduler ---
CELERY_BEAT_ENABLED=true

# --- CORS / CSRF (§23) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Redis throttle cache (§23, D3) ---
REDIS_THROTTLE_URL=redis://redis:6379/2

# --- Prometheus metrics (§25, E) ---
PROMETHEUS_METRICS_ENABLED=false

# --- Enrichment coalescing (§21, B7) ---
ENRICHMENT_COALESCE_WINDOW_SECONDS=300
ENRICHMENT_CHANGE_MAGNITUDE_THRESHOLD=0.15

# --- Provider input limits (D5 data-minimization) ---
MAX_PROVIDER_INPUT_CHARS=8000

# --- Monthly AI budget defaults (B8) ---
DEFAULT_MONTHLY_TOKEN_BUDGET=100000
DEFAULT_MONTHLY_COST_BUDGET_USD=50.00

# ============================================================================
# Phase 11: Local Provider Configuration
# ============================================================================

# --- Object storage (Phase 11) ---
# STORAGE_BACKEND: local | minio | s3
STORAGE_BACKEND=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=studyai
MINIO_REGION=us-east-1
MINIO_SECURE=false

# Production: use AWS S3
# STORAGE_BACKEND=s3
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_BUCKET=studyai-prod
# S3_REGION=us-east-1
# S3_ACCESS_KEY=<your-aws-access-key>
# S3_SECRET_KEY=<your-aws-secret-key>
# S3_SECURE=true

# --- OCR (StudyAI Canonical Production Stack: qwen3.5:4b Multimodal Vision) ---
# Options: qwen35, mock
OCR_PROVIDER_CHAIN=qwen35
OCR_PIPELINE_VERSION=qwen35-v1

# --- LLM (StudyAI Canonical Production Stack: qwen3.5:4b via Native Host Ollama) ---
LLM_PROVIDER=ollama
LLM_PROVIDER_CHAIN=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.5:4b
LLM_DISABLE_FALLBACK=1
LLM_NUM_CTX=16384
LLM_NUM_PREDICT=4096

# Thinking capability per stage (1 = on, 0 = off)
LLM_THINK_DEFAULT=0
LLM_THINK_OCR=0
LLM_THINK_ENRICHMENT=1
LLM_THINK_GAP_DETECTION=1
LLM_THINK_QUESTION_GEN=0
LLM_THINK_CHAT=0
LLM_THINK_TAGGING=0
LLM_THINK_VERIFICATION=1

# --- Web Search (WEB_SEARCH_PROVIDER: duckduckgo | mock) ---
# duckduckgo: real web search, no API key required
# mock: deterministic results for testing
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_MAX_RESULTS=5

# --- Embeddings (StudyAI Target Stack: Qwen/Qwen3-Embedding-0.6B) ---
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MODEL_VERSION=qwen3-embedding-0.6b-v1
EMBEDDING_DEVICE=auto  # cpu, cuda, mps, auto

# --- Email (EMAIL_BACKEND: mailpit | smtp | console) ---
# Local development: Mailpit (runs as separate service, web UI at http://localhost:8025)
EMAIL_BACKEND=mailpit
MAILPIT_HOST=mailpit
MAILPIT_PORT=1025
MAILPIT_API_URL=http://mailpit:8025
EMAIL_FROM=noreply@studyai.local

# Production: SMTP
# EMAIL_BACKEND=smtp
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=<your-sendgrid-api-key>
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# EMAIL_FROM=noreply@studyai.com

# Testing: Console (prints to stdout)
# EMAIL_BACKEND=console

# --- External AI providers (reserved for production) ---
# OCR_API_KEY is provider-specific and configured via LLM_PROVIDER_CHAIN / OPENAI_API_KEY etc.

# ============================================================================
# Phase 12: LangSmith Tracing
# ============================================================================
# Only set in deployment secrets / .env for backend processes.
# NEVER expose to frontend or client-side code.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=<your-langsmith-api-key>
LANGSMITH_PROJECT=studyai